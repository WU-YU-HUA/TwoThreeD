{
  "catalog_version": "0.3.0",
  "status": "recognition_and_preview",
  "runtime_integrated": true,
  "units": "mm",
  "description": "物件名稱、櫃子高度與模型對照設定。場景分類僅用於整理字典，不會自行產生該場景的設備。缺少模型的物件以 400 mm 紅色無字方塊顯示，離地面或承載檯面 100 mm；此尺寸不代表實物。",
  "name_normalization": [
    "NFKC",
    "trim",
    "remove_whitespace"
  ],
  "classification": {
    "rule_order": [
      "cabinet_keyword",
      "known_type_alias",
      "unclassified"
    ],
    "cabinet_keyword": {
      "contains_any": [
        "櫃",
        "柜"
      ],
      "category": "cabinet",
      "type_selection": "longest_matching_alias",
      "fallback_type_id": "cabinet"
    },
    "known_type_alias": {
      "type_selection": "longest_matching_alias"
    },
    "unclassified": {
      "requires_physical_object_evidence": true,
      "requires_review": true
    }
  },
  "cabinet_height_groups": {
    "low": {
      "name": "小／矮櫃",
      "height_mm": 900,
      "source": "user_default"
    },
    "tall": {
      "name": "高櫃／衣櫃",
      "height_mm": 2100,
      "source": "user_default"
    },
    "general": {
      "name": "其餘櫃子",
      "height_mm": 1500,
      "source": "user_default"
    }
  },
  "cabinet_height_policy": {
    "scope": "cabinet",
    "matching": "first_matching_rule",
    "input": "normalized_full_object_name",
    "rules": [
      {
        "id": "small_or_low",
        "contains_any": [
          "小",
          "矮"
        ],
        "height_group": "low"
      },
      {
        "id": "half_height_before_tall",
        "contains_any": [
          "半高櫃",
          "半高柜"
        ],
        "height_group": "general"
      },
      {
        "id": "tall_or_wardrobe",
        "contains_any": [
          "高櫃",
          "高柜",
          "衣櫃",
          "衣柜"
        ],
        "height_group": "tall"
      }
    ],
    "fallback_height_group": "general"
  },
  "unlabelled_symbol_rules": [
    {
      "id": "large_closed_frame_with_x",
      "requires": [
        "large_closed_frame",
        "paired_crossing_diagonals",
        "not_repeated_hatching"
      ],
      "type_id": "tall_cabinet",
      "height_group": "tall",
      "scope": "unlabelled_objects_only"
    }
  ],
  "missing_model_policy": {
    "representation": "floating_labeled_cube",
    "label_faces": [
      "front",
      "back",
      "left",
      "right",
      "top",
      "bottom"
    ],
    "label_source": "original_object_name",
    "cube_edge_mm": 400,
    "hover_offset_mm": 100,
    "preserve": [
      "object_id",
      "source_refs",
      "source_footprint",
      "support_relation"
    ],
    "export_requirements": {
      "independently_selectable": true,
      "independently_deletable": true,
      "replacement_ready": true,
      "labels_in_same_object": true,
      "preferred_sketchup_entity": "component",
      "sketchup_import_verified": false
    }
  },
