{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://twothreed.local/schemas/transfer-report.v5.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "TransferReport"
    },
    "schema_version": {
      "const": "5.0.0"
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_2d_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
          },
          "generated_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]*$"
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "method": {
            "enum": [
              "solid",
              "cut",
              "group",
              "derived"
            ]
          }
        },
        "required": [
          "source_2d_id",
          "generated_node_ids",
          "method"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "metrics": {
      "type": "object",
      "properties": {
        "walls": {
          "type": "integer",
          "minimum": 0
        },
        "openings": {
          "type": "integer",
          "minimum": 0
        },
        "slabs": {
          "type": "integer",
          "minimum": 0
        },
        "rooms": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 0
        },
        "doors": {
          "type": "integer",
          "minimum": 0
        },
        "chairs": {
          "type": "integer",
          "minimum": 0
        },
        "tall_cabinets": {
          "type": "integer",
          "minimum": 0
        },
        "tables": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "walls",
        "openings",
        "slabs",
        "rooms",
        "nodes",
        "columns",
        "doors",
        "chairs",
        "tall_cabinets",
        "tables"
      ],
      "additionalProperties": false
    },
    "preview_only": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "status",
    "mapping",
    "diagnostics",
    "metrics",
    "preview_only"
